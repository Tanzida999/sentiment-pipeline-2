{
  "name": "sentiment-pipeline",
  "version": "1.0.0",
  "description": "Real-time social media sentiment analysis pipeline on AWS (Kinesis -> Lambda -> Comprehend -> OpenSearch -> CloudWatch), built with AWS CDK (TypeScript).",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy",
    "producer": "ts-node producer/generate-posts.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.138",
    "@types/node": "^20.11.0",
    "aws-cdk": "^2.150.0",
    "esbuild": "^0.21.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.600.0",
    "@aws-sdk/client-comprehend": "^3.600.0",
    "@aws-sdk/client-kinesis": "^3.600.0",
    "@aws-sdk/credential-provider-node": "^3.600.0",
    "@opensearch-project/opensearch": "^2.11.0",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
